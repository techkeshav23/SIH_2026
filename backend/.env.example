# ---- Core ----
APP_ENV=dev                       # dev | prod
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./kalasetu.db   # dev; prod: postgresql+psycopg://user:pass@host/db

# ---- Auth / tokens ----
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# ---- OTP / SMS ----
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
SMS_PROVIDER=console              # console | msg91 | twilio  (console just logs the OTP)
SMS_API_KEY=
SMS_SENDER_ID=KLSETU

# ---- CORS / rate limiting / uploads ----
CORS_ORIGINS=*                    # prod: https://app.kalasetu.in,https://admin.kalasetu.in
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=8

# ---- AI ----
# Empty GEMINI_API_KEY (or USE_REAL_AI=false) -> functional stubs, app still works.
# Free key: https://aistudio.google.com/apikey
USE_REAL_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_QUOTA=50                 # per-user AI calls/day (cost guard)

# Image (F1): default Pillow (no key). Set true + `pip install rembg` for real bg-removal.
USE_REMBG=false
CLOUDINARY_URL=                   # optional hosted alternative

# Pricing (F3)
PRICING_MODEL_PATH=../ml/pricing_model.pkl
