# ---- Core ----
APP_ENV=dev                       # dev | prod
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./kalasetu.db   # dev; prod: postgresql+psycopg://user:pass@host/db

# ---- Auth / tokens ----
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30

# ---- OTP / SMS ----
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
SMS_PROVIDER=console              # console | msg91 | twilio  (console just logs the OTP)
SMS_API_KEY=
SMS_SENDER_ID=KLSETU

# ---- CORS / rate limiting / uploads ----
CORS_ORIGINS=*                    # prod: https://app.kalasetu.in,https://admin.kalasetu.in
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=8

# ---- AI (Vertex AI primary) ----
# USE_REAL_AI=false -> functional stubs (app still works end-to-end, no cloud needed).
USE_REAL_AI=false

# Vertex AI (Google Cloud) — preferred for prod/govt (IAM auth, India data residency).
# Auth via Application Default Credentials:
#   dev:    gcloud auth application-default login
#   server: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Enable the Vertex AI API on the project first.
USE_VERTEX=true
GCP_PROJECT=                      # your GCP project id
GCP_LOCATION=asia-south1          # Mumbai region
GOOGLE_APPLICATION_CREDENTIALS=   # path to service-account json (or use gcloud ADC)

# Fallback: Gemini Developer API (set USE_VERTEX=false to use this). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash     # same model id on both backends
AI_DAILY_QUOTA=50                 # per-user AI calls/day (cost guard)

# Image (F1): default Pillow (no key). Set true + `pip install rembg` for real bg-removal.
USE_REMBG=false
CLOUDINARY_URL=                   # optional hosted alternative

# Pricing (F3)
PRICING_MODEL_PATH=../ml/pricing_model.pkl

# ---- Payments (P4) ----
PAYMENT_PROVIDER=mock             # mock | razorpay  (mock simulates the gateway, no keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
