# ---- Core ----
APP_ENV=dev                       # dev | prod
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./kalasetu.db   # dev; prod: postgresql+psycopg://user:pass@host/db

# ---- AI toggles ----
# When a provider key is empty, the service falls back to a functional stub
# so the whole app still runs end-to-end for demos.
USE_REAL_AI=false

# Image (F1)
CLOUDINARY_URL=                   # cloudinary://<key>:<secret>@<cloud>

# Language (F2) — Bhashini (govt) primary
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
OPENAI_API_KEY=                   # Whisper STT fallback + optional LLM
GEMINI_API_KEY=                   # LLM for description generation

# Pricing (F3)
PRICING_MODEL_PATH=../ml/pricing_model.pkl
