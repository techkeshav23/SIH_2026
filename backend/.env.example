# ---- Core ----
APP_ENV=dev                       # dev | prod
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./kalasetu.db   # dev; prod: postgresql+psycopg://user:pass@host/db

# ---- AI ----
# When GEMINI_API_KEY is empty (or USE_REAL_AI=false) the services fall back to
# functional stubs, so the whole app still runs end-to-end for demos.
USE_REAL_AI=false

# Gemini — powers F2 (voice -> listing) and F3 (pricing reasoning).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Image (F1): default Pillow (no key). Set true + `pip install rembg` for real bg-removal.
USE_REMBG=false
CLOUDINARY_URL=                   # optional hosted alternative: cloudinary://key:secret@cloud

# Pricing (F3)
PRICING_MODEL_PATH=../ml/pricing_model.pkl
